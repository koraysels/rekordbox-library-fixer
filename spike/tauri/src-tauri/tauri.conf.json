{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rekordbox Library Fixer Tauri Test",
  "version": "0.0.1",
  "identifier": "com.koraysels.rekordbox-library-fixer.tauri-test",
  "build": {
    "frontendDist": "../frontend"
  },
  "app": {
    "windows": [
      {
        "title": "Rekordbox Library Fixer (Tauri test)",
        "width": 1280,
        "height": 820
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/backend"
    ],
    "macOS": {
      "signingIdentity": "-",
      "hardenedRuntime": false
    },
    "resources": {
      "../../pydb/build/dist/rbdb/": "rbdb/"
    }
  }
}