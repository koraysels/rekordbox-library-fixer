# Development server configuration
VITE_DEV_PORT=3000
VITE_DEV_SERVER_URL=http://localhost:3000

# Environment
NODE_ENV=development
# rekordbox master.db key, bundled into the build by scripts/write-bundled-key.mjs.
# Leave empty to build without it (the app then asks for the key). Never commit a real one.
REKORDBOX_DB_KEY=
