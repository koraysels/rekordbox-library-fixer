{
  "name": "rekordbox-library-manager",
  "version": "0.6.0",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "main": "dist/main/main.js",
  "scripts": {
    "dev": "concurrently \"pnpm dev:vite\" \"pnpm dev:electron\"",
    "dev:vite": "vite",
    "dev:electron": "pnpm build:main && NODE_ENV=development electron .",
    "build": "pnpm typecheck && pnpm build:vite && pnpm build:main",
    "build:check": "pnpm lint:check && pnpm build",
    "build:vite": "vite build",
    "build:main": "tsc -p tsconfig.main.json",
    "dist": "pnpm clean:release && pnpm build && electron-builder",
    "dist:mac": "pnpm clean:release && pnpm build && electron-builder --mac",
    "dist:win": "pnpm clean:release && pnpm build && electron-builder --win",
    "dist:linux": "pnpm clean:release && pnpm build && electron-builder --linux",
    "dist:all": "pnpm clean:release && pnpm build && electron-builder --mac --win --linux",
    "test": "pnpm test:unit && pnpm test:e2e",
    "test:unit": "vitest",
    "test:unit:ui": "vitest --ui",
    "test:unit:watch": "vitest --watch",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "lint": "eslint src --ext .js,.ts,.tsx",
    "lint:fix": "eslint src --ext .js,.ts,.tsx --fix",
    "lint:check": "eslint src --ext .js,.ts,.tsx --max-warnings 0",
    "clean:release": "rm -rf release/*",
    "postinstall": "echo 'Post install complete'",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.main.json"
  },
  "keywords": [
    "rekordbox",
    "dj",
    "library",
    "management"
  ],
  "author": {
    "name": "Koray Sels",
    "email": "koray@example.com"
  },
  "license": "SEE LICENSE IN LICENSE",
  "description": "A powerful tool for managing and fixing Rekordbox libraries",
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/vite": "^4.3.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/crypto-js": "^4.2.2",
    "@types/fuzzy-search": "^2.1.5",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.19.19",
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.2.3",
    "@types/xml2js": "^0.4.14",
    "@typescript-eslint/eslint-plugin": "^8.60.1",
    "@typescript-eslint/parser": "^8.60.1",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/ui": "^4.1.8",
    "autoprefixer": "^10.5.3",
    "concurrently": "^10.0.3",
    "electron": "^42.3.3",
    "electron-builder": "^26.8.1",
    "eslint": "^8.57.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "fake-indexeddb": "^6.2.5",
    "happy-dom": "^20.10.1",
    "jsdom": "^29.1.1",
    "playwright": "^1.60.0",
    "postcss": "^8.5.19",
    "tailwindcss": "^4.3.2",
    "typescript": "^5.5.4",
    "vite": "^8.0.16",
    "vitest": "^4.1.8"
  },
  "dependencies": {
    "@radix-ui/react-popover": "^1.1.15",
    "@tanstack/react-router": "^1.170.11",
    "better-sqlite3-multiple-ciphers": "^13.0.3",
    "crypto-js": "^4.2.0",
    "dexie": "^4.4.3",
    "dexie-react-hooks": "^4.4.0",
    "dropbox": "^10.34.0",
    "electron-context-menu": "^4.1.2",
    "framer-motion": "^12.40.0",
    "fuzzy-search": "^3.2.1",
    "glob": "^13.0.6",
    "lucide-react": "^1.17.0",
    "media-chrome": "^4.19.2",
    "music-metadata": "^10.4.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-dropzone": "^15.0.0",
    "react-hook-form": "^7.77.0",
    "recharts": "^3.8.1",
    "xml2js": "^0.6.2",
    "zustand": "^5.0.14"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "electron-winstaller",
      "lzma-native"
    ]
  },
  "build": {
    "appId": "com.rekordbox.library.manager",
    "productName": "Rekordbox Library Fixer",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist/main/**/*",
      "package.json"
    ],
    "publish": {
      "provider": "github",
      "owner": "koraysels",
      "repo": "rekordbox-library-fixer"
    },
    "mac": {
      "category": "public.app-category.music",
      "icon": "assets/icons/icon.icns",
      "darkModeSupport": true,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "win": {
      "icon": "assets/icons/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "ia32"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "ia32"
          ]
        }
      ]
    },
    "linux": {
      "icon": "assets/icons",
      "category": "AudioVideo",
      "target": [
        "AppImage",
        "deb"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Rekordbox Library Fixer"
    },
    "dmg": {
      "title": "Rekordbox Library Fixer",
      "window": {
        "width": 600,
        "height": 400
      },
      "contents": [
        {
          "x": 150,
          "y": 200
        },
        {
          "x": 450,
          "y": 200,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "asarUnpack": [
      "**/node_modules/better-sqlite3-multiple-ciphers/**"
    ]
  }
}
